@article{10.1007/s10844-025-00968-y,
  author = {Raihan, Nishat and Goswami, Dhiman and Puspo, Sadiya Sayara Chowdhury and Siddiq, Mohammed Latif and Newman, Christian and Ranasinghe, Tharindu and Santos, Joanna C. S. and Zampieri, Marcos},
  title = {On the performance of large language models on introductory programming assignments},
  year = {2025},
  issue_date = {Feb 2026},
  publisher = {Kluwer Academic Publishers},
  address = {USA},
  volume = {64},
  number = {1},
  issn = {0925-9902},
  url = {https://doi.org/10.1007/s10844-025-00968-y},
  doi = {10.1007/s10844-025-00968-y},
  abstract = {Recent advances in artificial intelligence (AI), machine learning (ML), and natural language processing (NLP) have led to the development of a new generation of Large Language Models (LLMs) trained on massive amounts of data. Commercial applications (e.g., ChatGPT) have made this available to the general public, enabling the use of LLMs to produce high-quality texts for academic and professional purposes. Educational institutions are increasingly aware of students’ use of AI-generated content and are researching its impact and potential misuse. Computer Science (CS) and related fields are particularly affected, as LLMs can also generate programming code in various languages. To understand the potential impact of publicly available LLMs in CS education, we extend our previously introduced CSEPrompts (Raihan et al. 2024), a framework comprising hundreds of programming exercise prompts and multiple-choice questions from introductory CS and programming courses. We provide experimental results on CSEPrompts, evaluating the performance of several LLMs in generating Python code and answering basic computer science and programming questions, offering insights into the implications of this technology for CS education.},
  journal = {J. Intell. Inf. Syst.},
  month = aug,
  pages = {239–263},
  numpages = {25},
  keywords = {Benchmark dataset, Code LLM, Prompting},
}

